# Copia este archivo a config/.env y rellena las claves reales.
# config/.env está ignorado por git: NUNCA lo subas al repositorio.
#
# Uso desde Python:
#   from quant_engine.config import get_settings
#   settings = get_settings()
#   settings.require("finnhub_api_key")

# --- Proveedores de datos de mercado ---
# Alpha Vantage: plan gratuito muy limitado (25 requests/día). Solo para pruebas.
ALPHA_VANTAGE_API_KEY=

# Twelve Data: buena opción como proveedor secundario / fallback.
TWELVE_DATA_API_KEY=

# Finnhub: cotizaciones en tiempo real y websocket (mercado de EE. UU.).
FINNHUB_API_KEY=

# Marketstack: datos EOD. El plan gratuito es limitado.
MARKETSTACK_API_KEY=

# Tiingo: datos EOD de buena calidad, útil para validar/contrastar.
TIINGO_API_KEY=

# ipstack: geolocalización de IPs. No es un proveedor de datos de mercado.
IPSTACK_API_KEY=

# --- Configuración del motor ---
# Proveedor por defecto: yfinance | finnhub | twelvedata | tiingo | marketstack
DEFAULT_DATA_PROVIDER=yfinance

# Directorio donde se guardará la caché local (Parquet/JSONL).
DATA_CACHE_DIR=data/cache

# Timeout en segundos para llamadas HTTP a proveedores.
REQUEST_TIMEOUT=30
